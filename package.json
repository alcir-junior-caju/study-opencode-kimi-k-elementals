{
  "name": "diario-colecao-elementais",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "svelte-kit sync && NODE_OPTIONS='--experimental-vm-modules' jest --config jest.config.mjs --selectProjects unit",
    "test:integration": "svelte-kit sync && NODE_OPTIONS='--experimental-vm-modules' jest --config jest.config.mjs --selectProjects integration",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:integration",
    "validate:seed": "node scripts/validate-seed.mjs",
    "measure:budgets": "node scripts/measure-budgets.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.1",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/svelte": "^5.0.0",
    "@types/jest": "^29.5.12",
    "fake-indexeddb": "^6.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-jester": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.0",
    "zod": "^3.23.0"
  }
}
